# Discord Self-Bot Token (your user account token)
# WARNING: Using self-bots violates Discord ToS - use at your own risk
DISCORD_TOKEN=your_discord_user_token_here

# Controller Bot (Optional - enables slash commands & UI)
# Create a bot at https://discord.com/developers/applications
BOT_TOKEN=
BOT_CLIENT_ID=

# Allowed Users - Comma-separated user IDs who can control the bot
# Right-click user → Copy User ID (requires Developer Mode)
# Leave empty to only allow the bot's own account
ALLOWED_USERS=

# Allowed Roles - Comma-separated role IDs that can control the bot
# Right-click role → Copy Role ID (requires Developer Mode)
# Users with ANY of these roles can use the bot
ALLOWED_ROLES=

# Allowed Guilds - Comma-separated server IDs (leave empty for all servers)
# Right-click server → Copy Server ID (requires Developer Mode)
ALLOWED_GUILDS=

# Plex Server Configuration
PLEX_URL=http://localhost:32400
PLEX_TOKEN=your_plex_token_here
# Plex username to limit transcode stopping (only stops transcodes for this user)
PLEX_USERNAME=moderniselife

# Video Stream Settings
# Resolution: 480, 720, 1080, 1440 (height in pixels)
# Discord Nitro max: 1440p 60fps
DEFAULT_QUALITY=1080
# Video bitrate in kbps (higher = better quality, more bandwidth)
# Recommended: 8000 for 1080p30, 10000 for 1080p60, 15000 for 1440p60
MAX_BITRATE=10000
# Audio bitrate in kbps (128, 192, 256, 320)
AUDIO_BITRATE=256

# Show FFmpeg logs (set to 'true' to show all logs, 'false' to hide unless error)
SHOW_FFMPEG_LOGS=false

# Debug logs for Go Live stream library (set to empty to hide, 'demux:*' to show stream info)
DEBUG=
# Frame rate (30 or 60 - 60 requires Discord Nitro)
FRAME_RATE=30

# Command Prefix (for text commands, optional)
PREFIX=!

# Voice Commands (experimental)
# Enable voice command recognition (requires Vosk model)
VOICE_COMMANDS_ENABLED=false
# Wake word to activate voice commands (e.g., "bob, pause")
VOICE_WAKE_WORD=bob
# Path to Vosk model (download from https://alphacephei.com/vosk/models)
# Recommended: vosk-model-small-en-us-0.15 (40MB)
VOSK_MODEL_PATH=/app/vosk-model

# YouTube Cast Receiver (allows casting YouTube videos to Bob)
# Enable Cast receiver - makes SchroStream discoverable as a cast target
CAST_ENABLED=true
CAST_DEVICE_NAME=SchroStream
CAST_FRIENDLY_NAME=SchroStream (Bob)
CAST_NOTIFICATION_CHANNEL_ID=  # Optional: specific channel ID for Cast notifications

# Plex Cast Receiver (allows casting from Plex apps to Bob)
PLEX_CAST_ENABLED=true
PLEX_CAST_NAME=SchroStream (Bob)
PLEX_CAST_PORT=32500

# Web Control (required for Cast receiver to work)
# User ID that will be used for web/cast initiated playback
WEB_USER_ID=
# Default guild (server) ID for web/cast playback
WEB_GUILD_ID=
# Default voice channel ID for web/cast playback
WEB_CHANNEL_ID=

# YouTube Premium (for high bitrate streams)
# Path to cookies.txt file exported from browser with YT Premium account
# Use browser extension like "Get cookies.txt" to export Netscape format cookies
# This unlocks higher bitrate streams at all resolutions
YOUTUBE_COOKIES_PATH=/app/cookies.txt
# Prefer highest bitrate even if 4K/1440p (we downscale to 1080p anyway)
YOUTUBE_PREFER_HIGH_BITRATE=true

# GPU Transcoding (NVIDIA only)
# Enable NVENC hardware encoding - much lower CPU usage
GPU_TRANSCODING=false
