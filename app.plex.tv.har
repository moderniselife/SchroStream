            "mimeType": "application/json",
            "compression": 135300,
            "text": "{\"MediaContainer\":{\"size\":75,\"totalSize\":90,\"offset\":0,\"allowSync\":true,\"art\":\"/:/resources/movie-fanart.jpg\",\"identifier\":\"com.plexapp.plugins.library\",\"librarySectionID\":1,\"librarySectionTitle\":\"Movies\",\"librarySectionUUID\":\"d0cc0b98-03c3-462c-aaf7-50514a8237a8\",\"mediaTagPrefix\":\"/system/bundle/media/flags/\",\"mediaTagVersion\":1758205129,\"thumb\":\"/:/resources/movie.png\",\"title1\":\"Movies\",\"title2\":\"All Movies\",\"viewGroup\":\"movie\",\"viewMode\":65592,\"Metadata\":[{\"ratingKey\":\"28666\",\"key\":\"/library/metadata/28666\",\"guid\":\"plex://movie/66cab8bc55469f6cd8d0624d\",\"slug\":\"anaconda-2025\",\"studio\":\"Fully Formed Entertainment\",\"type\":\"movie\",\"title\":\"Anaconda\",\"contentRating\":\"PG-13\",\"contentRatingAge\":13,\"summary\":\"Four childhood friends are going through a midlife crisis so they decide to remake their favorite horror movie from the 1990s in the Amazon Forest When a real giant anaconda shows up, they get more than what they bargain for and their comically chaotic movie making turns into a life-or-death situation. The movie that they're dying to remake? It might just kill them, literally.\",\"rating\":5.1,\"audienceRating\":7.6,\"year\":2025,\"tagline\":\"A comedy so big it'll leave you breathless.\",\"thumb\":\"/library/metadata/28666/thumb/1768286083\",\"art\":\"/library/metadata/28666/art/1768286083\",\"duration\":5654080,\"originallyAvailableAt\":\"2025-12-24\",\"addedAt\":1768286081,\"updatedAt\":1768286083,\"audienceRatingImage\":\"rottentomatoes://image.rating.upright\",\"primaryExtraKey\":\"/library/metadata/28667\",\"ratingImage\":\"rottentomatoes://image.rating.rotten\",\"Media\":[{\"id\":68932,\"duration\":5654080,\"bitrate\":11172,\"width\":1920,\"height\":816,\"aspectRatio\":2.35,\"audioChannels\":2,\"audioCodec\":\"aac\",\"videoCodec\":\"h264\",\"videoResolution\":\"1080\",\"container\":\"mkv\",\"videoFrameRate\":\"24p\",\"audioProfile\":\"lc\",\"videoP