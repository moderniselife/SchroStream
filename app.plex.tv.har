            "text": "{\"MediaContainer\":{\"size\":36,\"totalSize\":1217,\"offset\":0,\"allowSync\":true,\"art\":\"/:/resources/show-fanart.jpg\",\"identifier\":\"com.plexapp.plugins.library\",\"librarySectionID\":5,\"librarySectionTitle\":\"TV Shows\",\"librarySectionUUID\":\"a51a3802-023e-4f11-9dcb-a06e8588e236\",\"mediaTagPrefix\":\"/system/bundle/media/flags/\",\"mediaTagVersion\":1758205129,\"nocache\":true,\"thumb\":\"/:/resources/show.png\",\"title1\":\"TV Shows\",\"title2\":\"All Shows\",\"viewGroup\":\"show\",\"viewMode\":65592,\"Metadata\":[{\"ratingKey\":\"10876\",\"key\":\"/library/metadata/10876\",\"parentRatingKey\":\"10861\",\"grandparentRatingKey\":\"8061\",\"guid\":\"plex://episode/5d9c0ba3e98e47001eb2f7e5\",\"parentGuid\":\"plex://season/602e5a1267f4c8002ce25ab1\",\"grandparentGuid\":\"plex://show/5d9c07f94eefaa001f5d253f\",\"grandparentSlug\":\"parks-and-recreation\",\"type\":\"episode\",\"title\":\"The Bubble\",\"titleSort\":\"Bubble\",\"grandparentKey\":\"/library/metadata/8061\",\"parentKey\":\"/library/metadata/10861\",\"grandparentTitle\":\"Parks and Recreation\",\"parentTitle\":\"Season 3\",\"contentRating\":\"TV-14\",\"summary\":\"Everyone in the office is unhappy when Chris decides to make some big changes in the parks department -- especially Tom who starts to question his career choices. Leslie is caught off guard when Ben has a meeting with her mom.\",\"index\":15,\"parentIndex\":3,\"audienceRating\":7.9,\"viewCount\":1,\"lastViewedAt\":1768815634,\"year\":2011,\"thumb\":\"/library/metadata/10876/thumb/1767989696\",\"art\":\"/library/metadata/10861/art/1767989696\",\"parentThumb\":\"/library/metadata/10861/thumb/1767989696\",\"grandparentThumb\":\"/library/metadata/8061/thumb/1767893636\",\"grandparentArt\":\"/library/metadata/8061/art/1767893636\",\"grandparentTheme\":\"/library/metadata/8061/theme/1767893636\",\"duration\":1272235,\"originallyAvailableAt\":\"2011-05-19\",\"addedAt\":1762786615,\"updatedAt\":1767989696,\"audienceRating