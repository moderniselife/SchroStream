\",\"failureBIFRetryCount\":\"2\",\"videoProfile\":\"high\"}]}],\"Image\":[{\"alt\":\"The Amateur\",\"type\":\"coverPoster\",\"url\":\"/library/metadata/21023/thumb/1766371489\"},{\"alt\":\"The Amateur\",\"type\":\"background\",\"url\":\"/library/metadata/21023/art/1766371489\"},{\"alt\":\"The Amateur\",\"type\":\"clearLogo\",\"url\":\"/library/metadata/21023/clearLogo/1766371489\"}],\"UltraBlurColors\":{\"topLeft\":\"141317\",\"topRight\":\"092235\",\"bottomRight\":\"082139\",\"bottomLeft\":\"041425\"},\"Genre\":[{\"tag\":\"Action\"},{\"tag\":\"Thriller\"}],\"Country\":[{\"tag\":\"United States of America\"}],\"Director\":[{\"tag\":\"James Hawes\"}],\"Writer\":[{\"tag\":\"Robert Littell\"},{\"tag\":\"Ken Nolan\"}],\"Role\":[{\"tag\":\"Rami Malek\"},{\"tag\":\"Holt McCallany\"},{\"tag\":\"Danny Sapani\"}]},{\"ratingKey\":\"28666\",\"key\":\"/library/metadata/28666\",\"guid\":\"plex://movie/66cab8bc55469f6cd8d0624d\",\"slug\":\"anaconda-2025\",\"studio\":\"Fully Formed Entertainment\",\"type\":\"movie\",\"title\":\"Anaconda\",\"librarySectionTitle\":\"Movies\",\"librarySectionID\":1,\"librarySectionKey\":\"/library/sections/1\",\"contentRating\":\"PG-13\",\"contentRatingAge\":13,\"summary\":\"Four childhood friends are going through a midlife crisis so they decide to remake their favorite horror movie from the 1990s in the Amazon Forest When a real giant anaconda shows up, they get more than what they bargain for and their comically chaotic movie making turns into a life-or-death situation. The movie that they're dying to remake? It might just kill them, literally.\",\"rating\":5.1,\"audienceRating\":7.6,\"year\":2025,\"tagline\":\"A comedy so big it'll leave you breathless.\",\"thumb\":\"/library/metadata/28666/thumb/1768286083\",\"art\":\"/library/metadata/28666/art/1768286083\",\"duration\":5654080,\"originallyAvailableAt\":\"2025-12-24\",\"addedAt\":1768286081,\"updatedAt\":1768286083,\"audienceRatingImage\":\"rottentomatoes://image.rating.upright\",\"primaryExtr