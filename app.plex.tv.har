            "text": "{\"MediaContainer\":{\"size\":7,\"totalSize\":7,\"offset\":0,\"Metadata\":[{\"ratingKey\":\"14595\",\"key\":\"/library/metadata/14595\",\"guid\":\"plex://movie/5d9f351fca3253001ef27f25\",\"slug\":\"barbie-as-rapunzel\",\"studio\":\"Mainframe Entertainment\",\"type\":\"movie\",\"title\":\"Barbie as Rapunzel\",\"librarySectionTitle\":\"Movies\",\"librarySectionID\":1,\"librarySectionKey\":\"/library/sections/1\",\"contentRating\":\"G\",\"contentRatingAge\":5,\"summary\":\"Barbie stars as Rapunzel, a young girl who is entrapped by a magical barrier by the wicked, Gothel. Rapunzel finds an escape where she finds a Prince and a feud between two kingdoms which goes back to the day she was kidnapped as a child.\",\"audienceRating\":6.8,\"year\":2002,\"tagline\":\"Love and imagination can change the world.\",\"thumb\":\"/library/metadata/14595/thumb/1765849327\",\"art\":\"/library/metadata/14595/art/1765849327\",\"duration\":5025487,\"originallyAvailableAt\":\"2002-09-30\",\"addedAt\":1765849325,\"updatedAt\":1765849327,\"audienceRatingImage\":\"rottentomatoes://image.rating.upright\",\"chapterSource\":\"media\",\"primaryExtraKey\":\"/library/metadata/14596\",\"Media\":[{\"id\":29365,\"duration\":5025487,\"bitrate\":12062,\"width\":1280,\"height\":720,\"aspectRatio\":1.78,\"audioChannels\":6,\"audioCodec\":\"ac3\",\"videoCodec\":\"h264\",\"videoResolution\":\"720\",\"container\":\"mkv\",\"videoFrameRate\":\"NTSC\",\"videoProfile\":\"high\",\"hasVoiceActivity\":false,\"Part\":[{\"id\":29365,\"key\":\"/library/parts/29365/1721455648/file.mkv\",\"duration\":5025487,\"file\":\"/all/pd_zurg/mnt/pd_zurg/movies/Barbie as Rapunzel.2002.720p.AC3 5.1.H264-Zero00/Barbie as Rapunzel 2002.mkv\",\"size\":7577429477,\"container\":\"mkv\",\"failureBIFResultCode\":\"3\",\"failureBIFRetryCount\":\"2\",\"videoProfile\":\"high\"}]}],\"Image\":[{\"alt\":\"Barbie as Rapunzel\",\"type\":\"coverPoster\",\"url\":\"/library/metadata/14595/thumb/1765849327\"},{\"alt\":\"Barbie as Rapunzel\",\"type\":\"background\",\"url\":\"/library/metadata/14595/art/1765849327\"},{\"alt\":\"Barbie as Rapunzel\",\"type\":\"clearLogo\",\"url\":\"/library/metadata/14595/clearLogo/1765849327\"}],\"UltraBlurColors\":{\"topLeft\":\"2e2356\",\"topRight\":\"a41665\",\"bottomRight\":\"9b3057\",\"bottomLeft\":\"9b276f\"},\"Genre\":[{\"tag\":\"Animation\"},{\"tag\":\"Family\"}],\"Country\":[{\"tag\":\"Canada\"}],\"Director\":[{\"tag\":\"Owen Hurley\"}],\"Writer\":[{\"tag\":\"Elana Lesser\"},{\"tag\":\"Cliff Ruby\"}],\"Role\":[{\"tag\":\"Kelly Sheridan\"},{\"tag\":\"Anjelica Huston\"},{\"tag\":\"Cree Summer\"}]},{\"ratingKey\":\"14592\",\"key\":\"/library/metadata/14592\",\"guid\":\"plex://movie/5d9f352006d220001feb455f\",\"slug\":\"barbie-in-the-nutcracker\",\"studio\":\"Mattel\",\"type\":\"movie\",\"title\":\"Barbie in the Nutcracker\",\"librarySectionTitle\":\"Movies\",\"librarySectionID\":1,\"librarySectionKey\":\"/library/sections/1\",\"contentRating\":\"G\",\"contentRatingAge\":5,\"summary\":\"Barbie (Kelly Sheridan) shows that if you are kind, clever and brave, anything is possible in this tale of Clara (Kelly Sheridan) and her amazing Nutcracker (Kirby Morrow), who set off on an adventure to find the Sugarplum Princess.\",\"rating\":2.0,\"audienceRating\":6.0,\"year\":2001,\"tagline\":\"Starring in Her First Movie!\",\"thumb\":\"/library/metadata/14592/thumb/1768838593\",\"art\":\"/library/metadata/14592/art/1768838593\",\"duration\":4587116,\"originallyAvailableAt\":\"2001-10-02\",\"addedAt\":1765849321,\"updatedAt\":1768838593,\"audienceRatingImage\":\"rottentomatoes://image.rating.upright\",\"chapterSource\":\"media\",\"primaryExtraKey\":\"/library/metadata/14594\",\"ratingImage\":\"rottentomatoes://image.rating.rotten\",\"Media\":[{\"id\":29362,\"duration\":4587116,\"bitrate\":13785,\"width\":1280,\"height\":720,\"aspectRatio\":1.78,\"audioChannels\":6,\"audioCodec\":\"ac3\",\"videoCodec\":\"h264\",\"videoResolution\":\"720\",\"container\":\"mkv\",\"video