,\"aspectRatio\":1.85,\"audioChannels\":6,\"audioCodec\":\"ac3\",\"videoCodec\":\"h264\",\"videoResolution\":\"1080\",\"container\":\"mkv\",\"videoFrameRate\":\"24p\",\"videoProfile\":\"high\",\"hasVoiceActivity\":false,\"Part\":[{\"id\":43920,\"key\":\"/library/parts/43920/1763806759/file.mkv\",\"duration\":6325344,\"file\":\"/all/pd_zurg/mnt/pd_zurg/movies/The.Roses.2025.1080p.BluRay.x264-playHD_EniaHD/The.Roses.2025.1080p.BluRay.x264-playHD_EniaHD.mkv\",\"size\":15372009570,\"container\":\"mkv\",\"failureBIFResultCode\":\"3\",\"failureBIFRetryCount\":\"2\",\"videoProfile\":\"high\"}]}],\"Image\":[{\"alt\":\"The Roses\",\"type\":\"coverPoster\",\"url\":\"/library/metadata/21100/thumb/1766594213\"},{\"alt\":\"The Roses\",\"type\":\"background\",\"url\":\"/library/metadata/21100/art/1766594213\"},{\"alt\":\"The Roses\",\"type\":\"clearLogo\",\"url\":\"/library/metadata/21100/clearLogo/1766594213\"}],\"UltraBlurColors\":{\"topLeft\":\"190312\",\"topRight\":\"0f0313\",\"bottomRight\":\"0d0418\",\"bottomLeft\":\"a7262b\"},\"Genre\":[{\"tag\":\"Comedy\"},{\"tag\":\"Drama\"}],\"Country\":[{\"tag\":\"United Kingdom\"},{\"tag\":\"United States of America\"}],\"Director\":[{\"tag\":\"Jay Roach\"}],\"Writer\":[{\"tag\":\"Warren Adler\"},{\"tag\":\"Tony McNamara\"}],\"Role\":[{\"tag\":\"Olivia Colman\"},{\"tag\":\"Benedict Cumberbatch\"},{\"tag\":\"Andy Samberg\"}]},{\"ratingKey\":\"21099\",\"key\":\"/library/metadata/21099\",\"guid\":\"plex://movie/68a06d285e43514249c563e4\",\"slug\":\"the-last-rhinos-a-new-hope\",\"studio\":\"Sixty Six Media\",\"type\":\"movie\",\"title\":\"The Last Rhinos: A New Hope\",\"titleSort\":\"Last Rhinos: A New Hope\",\"summary\":\"Photographer Ami Vitale follows a global effort to save the northern white rhinoceros from extinction. With only two surviving females, a team of scientists races to create the world's first surrogate rhino pregnancy.\",\"audienceRating\":6.5,\"year\":2025,\"thumb\":\"/library/metadata/21099/thumb/1766849554\",\"art\":\