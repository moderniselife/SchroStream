            "text": "{\"MediaContainer\":{\"size\":36,\"totalSize\":112,\"offset\":0,\"Metadata\":[{\"ratingKey\":\"19158\",\"key\":\"/library/metadata/19158\",\"guid\":\"plex://movie/645e8f63c345e3fb3550f5a1\",\"slug\":\"200-wolf-2024\",\"studio\":\"Studio 100 Animation\",\"type\":\"movie\",\"title\":\"200% Wolf\",\"librarySectionTitle\":\"Movies\",\"librarySectionID\":1,\"librarySectionKey\":\"/library/sections/1\",\"contentRating\":\"PG\",\"contentRatingAge\":8,\"summary\":\"Heroic poodle Freddy Lupin has everything it takes to lead his werewolf pack. Except respect. If only he were more... wolfish. But when a wayward wish transforms him into a werewolf and deposits a mischievous moon spirit on earth, Freddy must restore the cosmic order before earth and moon collide. Oops. One thing's for sure - Freddy will never question being a poodle again.\",\"audienceRating\":5.8,\"year\":2024,\"tagline\":\"When 100% isn't enough.\",\"thumb\":\"/library/metadata/19158/thumb/1766036260\",\"art\":\"/library/metadata/19158/art/1766036260\",\"duration\":5893417,\"originallyAvailableAt\":\"2024-06-06\",\"addedAt\":1766036258,\"updatedAt\":1766036260,\"audienceRatingImage\":\"imdb://image.rating\",\"Media\":[{\"id\":41144,\"duration\":5893417,\"bitrate\":6725,\"width\":1920,\"height\":1080,\"aspectRatio\":1.78,\"audioChannels\":6,\"audioCodec\":\"ac3\",\"videoCodec\":\"h264\",\"videoResolution\":\"1080\",\"container\":\"mkv\",\"videoFrameRate\":\"24p\",\"videoProfile\":\"constrained baseline\",\"hasVoiceActivity\":false,\"Part\":[{\"id\":41144,\"key\":\"/library/parts/41144/1746999759/file.mkv\",\"duration\":5893417,\"file\":\"/all/pd_zurg/mnt/pd_zurg/movies/200%.Wolf.2024.Dub.1080p.WEB-DL.DD.5.1.x264-ELEKTRI4KA/200%.Wolf.2024.Dub.1080p.WEB-DL.DD.5.1.x264-ELEKTRI4KA.mkv\",\"size\":4954057702,\"container\":\"mkv\",\"hasThumbnail\":\"1\",\"indexes\":\"sd\",\"videoProfile\":\"constrained baseline\"}]}],\"Image\":[{\"alt\":\"200% Wolf\",\"type\":\"coverPoster\",\"url\":\"/library/metadata/19158/thumb/1766036260\"},{\"alt\":\"200% Wolf\",\"type\":\"background\",\"url\":\"/library/metadata/19158/art/1766036260\"},{\"alt\":\"200% Wolf\",\"type\":\"clearLogo\",\"url\":\"/library/metadata/19158/clearLogo/1766036260\"}],\"UltraBlurColors\":{\"topLeft\":\"0f2b5b\",\"topRight\":\"9d2867\",\"bottomRight\":\"131a4e\",\"bottomLeft\":\"0e276c\"},\"Genre\":[{\"tag\":\"Animation\"},{\"tag\":\"Action\"}],\"Country\":[{\"tag\":\"Australia\"},{\"tag\":\"France\"}],\"Director\":[{\"tag\":\"Alexs Stadermann\"}],\"Writer\":[{\"tag\":\"Fin Edquist\"}],\"Role\":[{\"tag\":\"Samara Weaving\"},{\"tag\":\"Jennifer Saunders\"},{\"tag\":\"Ilai Swindells\"}]},{\"ratingKey\":\"21016\",\"key\":\"/library/metadata/21016\",\"guid\":\"plex://movie/608f3ab9c022b4002def61f4\",\"slug\":\"alexander-and-the-terrible-horrible-no-good-very-bad-road-trip\",\"studio\":\"21 Laps Entertainment\",\"type\":\"movie\",\"title\":\"Alexander and the Terrible, Horrible, No Good, Very Bad Road Trip\",\"librarySectionTitle\":\"Movies\",\"librarySectionID\":1,\"librarySectionKey\":\"/library/sections/1\",\"contentRating\":\"PG\",\"contentRatingAge\":10,\"summary\":\"This film follows 11-year-old Alexander and his family as they embark on a dream Spring Break vacation to Mexico City only to have all their plans go terribly wrong when they discover a cursed idol. They're put to the test until they resolve to return it to its rightful home.\",\"rating\":5.8,\"audienceRating\":4.5,\"year\":2025,\"tagline\":\"It's about to become...  a terrible, horrible, no good, very bad road trip.\",\"thumb\":\"/library/metadata/21016/thumb/1766227373\",\"art\":\"/library/metadata/21016/art/1766227373\",\"duration\":5676800,\"originallyAvailableAt\":\"2025-03-28\",\"addedAt\":1766227370,\"updatedAt\":1766227373,\"audienceRatingImage\":\"rottentomatoes://image.rating.spilled\",\"primaryExtraKey\":\"/library/metadata/21017\",\"ratingImage\":\"rottentomatoes://image.rating.rotten\",\"Media\":[{\"id\":43722,\"duration\":