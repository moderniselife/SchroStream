tag\":\"Romance\"}],\"Country\":[{\"tag\":\"United Kingdom\"}],\"Director\":[{\"tag\":\"Luna Carmoon\"}],\"Writer\":[{\"tag\":\"Luna Carmoon\"}],\"Role\":[{\"tag\":\"Saura Lightfoot Leon\"},{\"tag\":\"Joseph Quinn\"},{\"tag\":\"Hayley Squires\"}]},{\"ratingKey\":\"22929\",\"key\":\"/library/metadata/22929\",\"guid\":\"plex://movie/656d4288eb1913b4cb24c49e\",\"slug\":\"girls-state-2024\",\"studio\":\"Concordia Studio\",\"type\":\"movie\",\"title\":\"Girls State\",\"librarySectionTitle\":\"Movies\",\"librarySectionID\":1,\"librarySectionKey\":\"/library/sections/1\",\"contentRating\":\"PG-13\",\"contentRatingAge\":10,\"summary\":\"Follows 500 adolescent girls from all across Missouri as they come together for a week-long immersion in a sophisticated democratic laboratory, where they organize a Supreme Court to consider the most contentious issues of the day.\",\"rating\":9.5,\"audienceRating\":6.8,\"year\":2024,\"tagline\":\"One nation. Under girls.\",\"thumb\":\"/library/metadata/22929/thumb/1767800039\",\"art\":\"/library/metadata/22929/art/1767800039\",\"duration\":5812599,\"originallyAvailableAt\":\"2024-04-05\",\"addedAt\":1766244015,\"updatedAt\":1767800039,\"audienceRatingImage\":\"rottentomatoes://image.rating.upright\",\"chapterSource\":\"media\",\"primaryExtraKey\":\"/library/metadata/22930\",\"ratingImage\":\"rottentomatoes://image.rating.ripe\",\"Media\":[{\"id\":48481,\"duration\":5812599,\"bitrate\":10644,\"width\":1918,\"height\":802,\"aspectRatio\":2.35,\"audioChannels\":6,\"audioCodec\":\"eac3\",\"videoCodec\":\"h264\",\"videoResolution\":\"1080\",\"container\":\"mkv\",\"videoFrameRate\":\"24p\",\"videoProfile\":\"high\",\"hasVoiceActivity\":false,\"Part\":[{\"id\":48481,\"key\":\"/library/parts/48481/1712302480/file.mkv\",\"duration\":5812599,\"file\":\"/all/pd_zurg/mnt/pd_zurg/movies/Girls.State.2024.1080p.ATVP.WEB-DL.DDP5.1.Atmos.H.264-FLUX/Girls.State.2024.1080p.ATVP.WEB-DL.DDP5.1.Atmos.H.264-FLUX.mkv\",\"size\":7733415745,\"container\":\"mkv\",\"indexes\":\"sd\",\"videoProfile\":\"high\"}]}],\"Image\":[{\"alt\":\"Girls State\",\"type\":\"coverPoster\",\"url\":\"/library/metadata/22929/thumb/1767800039\"},{\"alt\":\"Girls State\",\"type\":\"background\",\"url\":\"/library/metadata/22929/art/1767800039\"},{\"alt\":\"Girls State\",\"type\":\"clearLogo\",\"url\":\"/library/metadata/22929/clearLogo/1767800039\"}],\"UltraBlurColors\":{\"topLeft\":\"4c1d12\",\"topRight\":\"7d3528\",\"bottomRight\":\"572b10\",\"bottomLeft\":\"8d4634\"},\"Genre\":[{\"tag\":\"Documentary\"}],\"Country\":[{\"tag\":\"United States of America\"}],\"Director\":[{\"tag\":\"Jesse Moss\"},{\"tag\":\"Amanda McBaine\"}],\"Role\":[{\"tag\":\"Faith Glasgow\"},{\"tag\":\"Cecilia Bartin\"},{\"tag\":\"Nisha Murali\"}]},{\"ratingKey\":\"22903\",\"key\":\"/library/metadata/22903\",\"guid\":\"plex://movie/5d776c5996b655001fe2dbc8\",\"slug\":\"better-watch-out\",\"studio\":\"Best Medicine Productions\",\"type\":\"movie\",\"title\":\"Better Watch Out\",\"librarySectionTitle\":\"Movies\",\"librarySectionID\":1,\"librarySectionKey\":\"/library/sections/1\",\"contentRating\":\"R\",\"contentRatingAge\":16,\"summary\":\"When you think \\\"suburbs,\\\" you think \\\"safety,\\\" but this holiday night the suburbs are anything but safe. Ashley (Olivia DeJonge) thought this babysitting job would be an easy night, but the night takes a turn when dangerous intruders break in and terrorize her and Luke (Levi Miller), the 12-year-old she's watching. Ashley defends her charge to the best of her ability only to discover this is no normal home invasion.\",\"rating\":8.9,\"audienceRating\":6.4,\"year\":2016,\"tagline\":\"You might be home but you're not alone\",\"thumb\":\"/library/metadata/22903/thumb/1766417931\",\"art\":\"/library/metadata/22903/art/1766417931\",\"duration\":5334880,\"originallyAvailableAt\":\"2016-10-06\",\"addedAt\":1766236415,\"updatedAt\":1766417931,\"audienceRatingImage\":\"rottentomatoes://image.rating.upright\",\"chapterSource\":\"media\",\"p