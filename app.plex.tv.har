cted enemy.\",\"rating\":3.1,\"audienceRating\":3.3,\"year\":2025,\"tagline\":\"Deck the halls, dodge the bad guys.\",\"thumb\":\"/library/metadata/26649/thumb/1768838621\",\"art\":\"/library/metadata/26649/art/1768838621\",\"duration\":6481696,\"originallyAvailableAt\":\"2025-11-20\",\"addedAt\":1767276726,\"updatedAt\":1768838621,\"audienceRatingImage\":\"rottentomatoes://image.rating.spilled\",\"primaryExtraKey\":\"/library/metadata/26650\",\"ratingImage\":\"rottentomatoes://image.rating.rotten\",\"Media\":[{\"id\":63503,\"duration\":6481696,\"bitrate\":12321,\"width\":1918,\"height\":802,\"aspectRatio\":2.35,\"audioChannels\":6,\"audioCodec\":\"eac3\",\"videoCodec\":\"h264\",\"videoResolution\":\"1080\",\"container\":\"mkv\",\"videoFrameRate\":\"24p\",\"videoProfile\":\"high\",\"hasVoiceActivity\":false,\"Part\":[{\"id\":63503,\"key\":\"/library/parts/63503/1763717144/file.mkv\",\"duration\":6481696,\"file\":\"/all/pd_zurg/mnt/pd_zurg/movies/The.Family.Plan.2.2025.1080p.ATVP.WEB-DL.DDP5.1.H.264-FHC/The.Family.Plan.2.2025.1080p.ATVP.WEB-DL.DDP5.1.H.264-FHC.mkv\",\"size\":9983011545,\"container\":\"mkv\",\"indexes\":\"sd\",\"videoProfile\":\"high\"}]}],\"Image\":[{\"alt\":\"The Family Plan 2\",\"type\":\"coverPoster\",\"url\":\"/library/metadata/26649/thumb/1768838621\"},{\"alt\":\"The Family Plan 2\",\"type\":\"background\",\"url\":\"/library/metadata/26649/art/1768838621\"},{\"alt\":\"The Family Plan 2\",\"type\":\"clearLogo\",\"url\":\"/library/metadata/26649/clearLogo/1768838621\"}],\"UltraBlurColors\":{\"topLeft\":\"18294f\",\"topRight\":\"256197\",\"bottomRight\":\"204568\",\"bottomLeft\":\"142747\"},\"Genre\":[{\"tag\":\"Action\"},{\"tag\":\"Comedy\"}],\"Country\":[{\"tag\":\"United States of America\"}],\"Director\":[{\"tag\":\"Simon Cellan Jones\"}],\"Writer\":[{\"tag\":\"David Coggeshall\"}],\"Role\":[{\"tag\":\"Mark Wahlberg\"},{\"tag\":\"Michelle Monaghan\"},{\"tag\":\"Kit Harington\"}]},{\"ratingKey\":\"18799\",\"key\":\"/library/metadata/18799\",\"gu