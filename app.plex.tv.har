            "text": "{\"MediaContainer\":{\"size\":36,\"totalSize\":65,\"offset\":0,\"allowSync\":true,\"art\":\"/:/resources/movie-fanart.jpg\",\"identifier\":\"com.plexapp.plugins.library\",\"librarySectionID\":1,\"librarySectionTitle\":\"Movies\",\"librarySectionUUID\":\"d0cc0b98-03c3-462c-aaf7-50514a8237a8\",\"mediaTagPrefix\":\"/system/bundle/media/flags/\",\"mediaTagVersion\":1758205129,\"thumb\":\"/:/resources/movie.png\",\"title1\":\"Movies\",\"title2\":\"All Movies\",\"viewGroup\":\"movie\",\"viewMode\":65592,\"Metadata\":[{\"ratingKey\":\"18697\",\"key\":\"/library/metadata/18697\",\"guid\":\"plex://movie/62287ddfcf2de0737380365e\",\"slug\":\"alien-romulus\",\"studio\":\"20th Century Studios\",\"type\":\"movie\",\"title\":\"Alien: Romulus\",\"contentRating\":\"R\",\"contentRatingAge\":15,\"summary\":\"While scavenging the deep ends of a derelict space station, a group of young space colonists come face to face with the most terrifying life form in the universe.\",\"rating\":8.0,\"audienceRating\":8.5,\"year\":2024,\"tagline\":\"In space, no one can hear you.\",\"thumb\":\"/library/metadata/18697/thumb/1768838598\",\"art\":\"/library/metadata/18697/art/1768838598\",\"duration\":7140928,\"originallyAvailableAt\":\"2024-08-14\",\"addedAt\":1766028324,\"updatedAt\":1768838598,\"audienceRatingImage\":\"rottentomatoes://image.rating.upright\",\"chapterSource\":\"media\",\"primaryExtraKey\":\"/library/metadata/18715\",\"ratingImage\":\"rottentomatoes://image.rating.ripe\",\"Media\":[{\"id\":40062,\"duration\":7140928,\"bitrate\":41469,\"width\":1920,\"height\":1080,\"aspectRatio\":1.78,\"audioChannels\":8,\"audioCodec\":\"dca-ma\",\"videoCodec\":\"h264\",\"videoResolution\":\"1080\",\"container\":\"mkv\",\"videoFrameRate\":\"24p\",\"audioProfile\":\"ma\",\"videoProfile\":\"high\",\"hasVoiceActivity\":false,\"Part\":[{\"id\":40062,\"key\":\"/library/parts/40062/1733703739/file.mkv\",\"duration\":7140928,\"file\":\"/all/pd_zurg/mnt/pd_zurg/movies/Alien.Romulus.2024.Eng.Fre.Ger.Ita.Spa.1080p.BluRay.Remux.AVC.DTS-HD.MA-SGF/Alien.Romulus.2024.Eng.Fre.Ger.Ita.Spa.1080p.BluRay.Remux.AVC.DTS-HD.MA-SGF.mkv\",\"size\":37015833769,\"audioProfile\":\"ma\",\"container\":\"mkv\",\"indexes\":\"sd\",\"videoProfile\":\"high\"}]}],\"Image\":[{\"alt\":\"Alien: Romulus\",\"type\":\"coverPoster\",\"url\":\"/library/metadata/18697/thumb/1768838598\"},{\"alt\":\"Alien: Romulus\",\"type\":\"background\",\"url\":\"/library/metadata/18697/art/1768838598\"},{\"alt\":\"Alien: Romulus\",\"type\":\"clearLogo\",\"url\":\"/library/metadata/18697/clearLogo/1768838598\"}],\"UltraBlurColors\":{\"topLeft\":\"2d0e0c\",\"topRight\":\"5e0e0d\",\"bottomRight\":\"b00e0a\",\"bottomLeft\":\"6d0e0c\"},\"Genre\":[{\"tag\":\"Science Fiction\"},{\"tag\":\"Horror\"}],\"Country\":[{\"tag\":\"United States of America\"}],\"Collection\":[{\"tag\":\"Disney+ Top Movies (AU)\"}],\"Director\":[{\"tag\":\"Fede Álvarez\"}],\"Writer\":[{\"tag\":\"Fede Álvarez\"},{\"tag\":\"Rodo Sayagues\"}],\"Role\":[{\"tag\":\"Cailee Spaeny\"},{\"tag\":\"David Jonsson\"},{\"tag\":\"Archie Renaux\"}]},{\"ratingKey\":\"21023\",\"key\":\"/library/metadata/21023\",\"guid\":\"plex://movie/5f408db31ae7100041142250\",\"slug\":\"the-amateur-2025\",\"studio\":\"20th Century Studios\",\"type\":\"movie\",\"title\":\"The Amateur\",\"titleSort\":\"Amateur\",\"contentRating\":\"PG-13\",\"contentRatingAge\":14,\"summary\":\"After his life is turned upside down when his wife is killed in a London terrorist attack, a brilliant but introverted CIA decoder takes matters into his own hands when his supervisors refuse to take action.\",\"rating\":6.2,\"audienceRating\":8.7,\"year\":2025,\"tagline\":\"Don't underestimate him.\",\"thumb\":\"/library/metadata/21023/thumb/1766371489\",\"art\":\"/library/metadata/21023/art/1766371489\",\"duration\":7359394,\"originallyAvailableAt\":\"2025-04-09\",\"addedAt\":1766227382,\"updatedAt\":1766371489,\"audienceRatingImage\":\"rottentomatoes://image.rating.upright\",\"chapterSource\":\"media\",\"primaryExtraKey\":\"/library/metadata/23329\",\"ratingImage\":\"rottentomatoes://image.rating.ripe\",\"Media\":[{\"id\":43737,\"duration\":7359394,\"bitrate\":36804,\"width\":1920,\"height\":1080,\"aspectRatio\":1.78,\"audioChannels\":8,\"audioCodec\":\"truehd\",\"videoCodec\":\"h264\",\"videoResolution\":\"1080\",\"container\":\"mkv\",\"videoFrameRate\":\"24p\",\"videoProfile\":\"high\",\"hasVoiceActivity\":false,\"Part\":[{\"id\":43737,\"key\":\"/library/parts/43737/1751618280/file.mkv\",\"duration\":7359394,\"file\":\"/all/pd_zurg/mnt/pd_zurg/movies/www.UIndex.org    -    The Amateur 2025 REPACK 1080p BluRay REMUX AVC TrueHD Atmos 7 1-SilentRogue/The Amateur 2025 REPACK 1080p BluRay REMUX AVC TrueHD Atmos 7 1-SilentRogue.mkv\",\"size\":33856916002,\"container\":\"mkv\",\"failureBIFResultCode\":\"3\",\"failureBIFRetryCount\":\"2\",\"videoProfile\":\"high\"}]}],\"Image\":[{\"alt\":\"The Amateur\",\"type\":\"coverPoster\",\"url\":\"/library/metadata/21023/thumb/1766371489\"},{\"alt\":\"The Amateur\",\"type\":\"background\",\"url\":\"/library/metadata/21023/art/1766371489\"},{\"alt\":\"The Amateur\",\"type\":\"clearLogo\",\"url\":\"/library/metadata/21023/clearLogo/1766371489\"}],\"UltraBlurColors\":{\"topLeft\":\"141317\",\"topRight\":\"092235\",\"bottomRight\":\"082139\",\"bottomLeft\":\"041425\"},\"Genre\":[{\"tag\":\"Action\"},{\"tag\":\"Thriller\"}],\"Country\":[{\"tag\":\"United States of America\"}],\"Director\":[{\"tag\":\"James Hawes\"}],\"Writer\":[{\"tag\":\"Robert Littell\"},{\"tag\":\"Ken Nolan\"}],\"Role\":[{\"tag\":\"Rami Malek\"},{\"tag\":\"Holt McCallany\"},{\"tag\":\"Danny Sapani\"}]},{\"ratingKey\":\"21331\",\"key\":\"/library/metadata/21331\",\"guid\":\"plex://movie/5d776b9896b655001fe16522\",\"slug\":\"american-made\",\"studio\":\"Universal Pictures\",\"type\":\"movie\",\"title\":\"American Made\",\"contentRating\":\"R\",\"contentRatingAge\":15,\"summary\":\"Barry Seal was just an ordinary pilot who worked for TWA before he was recruited by the CIA in 1978. His work in South America eventually caught the eye of the Medellín Cartel, associated with Pablo Escobar, who needed a man with his skill set. Barry became a drug trafficker, gun smuggler and money launderer. Soon acquiring the title, 'The gringo that always delivers'.\",\"rating\":8.5,\"audienceRating\":7.9,\"year\":2017,\"tagline\":\"It's not a felony if you're doing it for the good guys.\",\"thumb\":\"/library/metadata/21331/thumb/1766231509\",\"art\":\"/library/metadata/21331/art/1766231509\",\"duration\":6898902,\"originallyAvailableAt\":\"2017-08-23\",\"addedAt\":1766231499,\"updatedAt\":1766231509,\"audienceRatingImage\":\"rottentomatoes://image.rating.upright\",\"chapterSource\":\"media\",\"primaryExtraKey\":\"/library/metadata/21388\",\"ratingImage\":\"rottentomatoes://image.rating.ripe\",\"Media\":[{\"id\":44301,\"duration\":6898902,\"bitrate\":22169,\"width\":1920,\"height\":1038,\"aspectRatio\":1.85,\"audioChannels\":8,\"audioCodec\":\"dca-ma\",\"videoCodec\":\"h264\",\"videoResolution\":\"1080\",\"container\":\"mkv\",\"videoFrameRate\":\"24p\",\"audioProfile\":\"ma\",\"videoProfile\":\"high\",\"hasVoiceActivity\":false,\"Part\":[{\"id\":44301,\"key\":\"/library/parts/44301/1559331811/file.mkv\",\"duration\":6898902,\"file\":\"/all/pd_zurg/mnt/pd_zurg/movies/American.Made.2017.INTERNAL.1080p.BluRay.X264-DEFLATE[rarbg]/American.Made.2017.INTERNAL.1080p.BluRay.X264-DEFLATE.mkv\",\"size\":19117677405,\"audioProfile\":\"ma\",\"container\":\"mkv\",\"failureBIFResultCode\":\"3\",\"failureBIFRetryCount\":\"2\",\"videoProfile\":\"high\"}]}],\"Image\":[{\"alt\":\"American Made\",\"type\":\"coverPoster\",\"url\":\"/library/metadata/21331/thumb/1766231509\"},{\"alt\":\"American Made\",\"type\":\"background\",\"url\":\"/library/metadata/21331/art/1766231509\"},{\"alt\":\"American Made\",\"type\":\"clearLogo\",\"url\":\"/library/metadata/21331/clearLogo/1766231509\"}],\"UltraBlurColors\":{\"topLeft\":\"580e04\",\"topRight\":\"870703\",\"bottomRight\":\"2a0504\",\"bottomLeft\":\"380e07\"},\"Genre\":[{\"tag\":\"Crime\"},{\"tag\":\"Action\"}],\"Country\":[{\"tag\":\"United States of America\"},{\"tag\":\"Luxembourg\"}],\"Director\":[{\"tag\":\"Doug Liman\"}],\"Writer\":[{\"tag\":\"Gary Spinelli\"}],\"Role\":[{\"tag\":\"Tom Cruise\"},{\"tag\":\"Domhnall Gleeson\"},{\"tag\":\"Sarah Wright\"}]},{\"ratingKey\":\"22295\",\"key\":\"/library/metadata/22295\",\"guid\":\"plex://movie/60e731fce18a10002cba8c78\",\"slug\":\"argylle\",\"studio\":\"Marv\",\"type\":\"movie\",\"title\":\"Argylle\",\"contentRating\":\"PG-13\",\"contentRatingAge\":13,\"summary\":\"Elly Conway, a reserved writer of spy stories who rarely ventures outside, finds her life entangled with actual secret service operations as the narratives she pens eerily mirror the operations of a menacing covert group. Aiden, professing to be an agent, intervenes to protect her from potential abduction or worse. Suddenly, Elly, along with her cherished feline, Alfie, find themselves navigating a shadowy realm filled with deceit and illusions.\",\"rating\":3.3,\"audienceRating\":7.0,\"year\":2024,\"tagline\":\"The greater the spy, the bigger the lie.\",\"thumb\":\"/library/metadata/22295/thumb/1766232145\",\"art\":\"/library/metadata/22295/art/1766232145\",\"duration\":8336352,\"originallyAvailableAt\":\"2024-01-31\",\"addedAt\":1766232136,\"updatedAt\":1766232145,\"audienceRatingImage\":\"rottentomatoes://image.rating.upright\",\"primaryExtraKey\":\"/library/metadata/22306\",\"ratingImage\":\"rottentomatoes://image.rating.rotten\",\"Media\":[{\"id\":46944,\"duration\":8336352,\"bitrate\":12178,\"width\":1920,\"height\":800,\"aspectRatio\":2.35,\"audioChannels\":6,\"audioCodec\":\"ac3\",\"videoCodec\":\"h264\",\"videoResolution\":\"1080\",\"container\":\"mkv\",\"videoFrameRate\":\"24p\",\"videoProfile\":\"high\",\"hasVoiceActivity\":false,\"Part\":[{\"id\":46944,\"key\":\"/library/parts/46944/1711138228/file.mkv\",\"duration\":8336352,\"file\":\"/all/pd_zur