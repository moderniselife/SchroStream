\":\"191f72\",\"topRight\":\"993c16\",\"bottomRight\":\"052a41\",\"bottomLeft\":\"2b04cb\"},\"Genre\":[{\"tag\":\"Animation\"},{\"tag\":\"Adventure\"}],\"Country\":[{\"tag\":\"United States of America\"}],\"Director\":[{\"tag\":\"Chris Renaud\"}],\"Writer\":[{\"tag\":\"Mike White\"},{\"tag\":\"Ken Daurio\"}],\"Role\":[{\"tag\":\"Steve Carell\"},{\"tag\":\"Kristen Wiig\"},{\"tag\":\"Will Ferrell\"}]},{\"ratingKey\":\"18682\",\"key\":\"/library/metadata/18682\",\"guid\":\"plex://movie/631bfefb0667a4eded0d5b66\",\"slug\":\"inside-out-2-2024-1\",\"studio\":\"Pixar\",\"type\":\"movie\",\"title\":\"Inside Out 2\",\"contentRating\":\"PG\",\"contentRatingAge\":6,\"summary\":\"A sequel that features Riley entering puberty and experiencing brand new, more complex emotions as a result. As Riley tries to adapt to her teenage years, her old emotions try to adapt to the possibility of being replaced.\",\"rating\":9.1,\"audienceRating\":9.4,\"viewCount\":1,\"lastViewedAt\":1720525596,\"year\":2024,\"tagline\":\"Make room for new emotions.\",\"thumb\":\"/library/metadata/18682/thumb/1768838598\",\"art\":\"/library/metadata/18682/art/1768838598\",\"duration\":5780512,\"originallyAvailableAt\":\"2024-06-12\",\"addedAt\":1766028316,\"updatedAt\":1768838598,\"audienceRatingImage\":\"rottentomatoes://image.rating.upright\",\"chapterSource\":\"media\",\"primaryExtraKey\":\"/library/metadata/18683\",\"ratingImage\":\"rottentomatoes://image.rating.ripe\",\"Media\":[{\"id\":40021,\"duration\":5780512,\"bitrate\":18767,\"width\":1920,\"height\":804,\"aspectRatio\":2.35,\"audioChannels\":6,\"audioCodec\":\"ac3\",\"videoCodec\":\"h264\",\"videoResolution\":\"1080\",\"container\":\"mkv\",\"videoFrameRate\":\"24p\",\"videoProfile\":\"high\",\"hasVoiceActivity\":false,\"Part\":[{\"id\":40021,\"key\":\"/library/parts/40021/1749669359/file.mkv\",\"duration\":5780512,\"file\":\"/all/pd_zurg/mnt/pd_zurg/movies/Inside.Out.2.2024.1080p.MA.WEB-DLRip.x264-HiDt_EniaHD/Inside.Out.2.2024.1080p.MA.WEB-DLRip.