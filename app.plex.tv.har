etadata/24930\",\"Image\":[{\"alt\":\"Ice Age: Scrat Tales\",\"type\":\"coverPoster\",\"url\":\"/library/metadata/24911/thumb/1766471834\"},{\"alt\":\"Ice Age: Scrat Tales\",\"type\":\"background\",\"url\":\"/library/metadata/24911/art/1766471834\"},{\"alt\":\"Ice Age: Scrat Tales\",\"type\":\"clearLogo\",\"url\":\"/library/metadata/24911/clearLogo/1766471834\"}],\"UltraBlurColors\":{\"topLeft\":\"072e56\",\"topRight\":\"125dac\",\"bottomRight\":\"854323\",\"bottomLeft\":\"325e99\"},\"Genre\":[{\"tag\":\"Animation\"},{\"tag\":\"Comedy\"}],\"Country\":[{\"tag\":\"United States of America\"}],\"Role\":[{\"tag\":\"Chris Wedge\"},{\"tag\":\"Kari Wahlgren\"}]},{\"ratingKey\":\"25103\",\"key\":\"/library/metadata/25103/children\",\"guid\":\"plex://show/5d9c08542df347001e3afd97\",\"slug\":\"gravity-falls\",\"studio\":\"Disney Television Animation\",\"type\":\"show\",\"title\":\"Gravity Falls\",\"librarySectionTitle\":\"TV Shows\",\"librarySectionID\":5,\"librarySectionKey\":\"/library/sections/5\",\"contentRating\":\"TV-Y7\",\"contentRatingAge\":8,\"summary\":\"When Dipper and Mabel Pines get sent to their great-uncle Stan's shop in Gravity Falls, Oregon for the summer, they think it will be boring. But when Dipper finds a strange journal in the woods, they learn some strange secrets about the town and its strange inhabitants.\",\"index\":1,\"audienceRating\":8.6,\"year\":2012,\"tagline\":\"Just West of Weird.\",\"thumb\":\"/library/metadata/25103/thumb/1766472708\",\"art\":\"/library/metadata/25103/art/1766472708\",\"theme\":\"/library/metadata/25103/theme/1766472708\",\"duration\":1320000,\"originallyAvailableAt\":\"2012-06-14\",\"leafCount\":40,\"viewedLeafCount\":0,\"childCount\":2,\"addedAt\":1766472427,\"updatedAt\":1766472708,\"audienceRatingImage\":\"themoviedb://image.rating\",\"Image\":[{\"alt\":\"Gravity Falls\",\"type\":\"coverPoster\",\"url\":\"/library/metadata/25103/thumb/1766472708\"},{\"alt\":\"Gravity Falls\",\"type\":\"background\",\"url\":\"/library/metadata/25103/art/1766472708\"},{\"alt\":\"Gravity Falls\",\"type\":\"clearLogo\",\"url\":\"/library/metadata/25103/clearLogo/1766472708\"}],\"UltraBlurColors\":{\"topLeft\":\"560d1d\",\"topRight\":\"8e3538\",\"bottomRight\":\"922d37\",\"bottomLeft\":\"9e3620\"},\"Genre\":[{\"tag\":\"Animation\"},{\"tag\":\"Comedy\"}],\"Country\":[{\"tag\":\"United States of America\"}],\"Role\":[{\"tag\":\"Jason Ritter\"},{\"tag\":\"Kristen Schaal\"},{\"tag\":\"Alex Hirsch\"}]},{\"ratingKey\":\"26144\",\"key\":\"/library/metadata/26144/children\",\"guid\":\"plex://show/5d9c09042df347001e3bb9f2\",\"slug\":\"the-owl-house\",\"studio\":\"Disney Television Animation\",\"type\":\"show\",\"title\":\"The Owl House\",\"titleSort\":\"Owl House\",\"librarySectionTitle\":\"TV Shows\",\"librarySectionID\":5,\"librarySectionKey\":\"/library/sections/5\",\"contentRating\":\"TV-Y7\",\"contentRatingAge\":8,\"summary\":\"An animated fantasy-comedy series that follows Luz, a self-assured teenage girl who accidentally stumbles upon a portal to a magical world where she befriends a rebellious witch, Eda, and an adorably tiny warrior, King. Despite not having magical abilities, Luz pursues her dream of becoming a witch by serving as Eda's apprentice at the Owl House and ultimately finds a new family in an unlikely setting.\",\"index\":1,\"audienceRating\":8.7,\"year\":2020,\"tagline\":\"Your Source for Sorcery\",\"thumb\":\"/library/metadata/26144/thumb/1766493936\",\"art\":\"/library/metadata/26144/art/1766493936\",\"theme\":\"/library/metadata/26144/theme/1766493936\",\"duration\":1320000,\"originallyAvailableAt\":\"2020-01-10\",\"leafCount\":3,\"viewedLeafCount\":0,\"childCount\":1,\"addedAt\":1766493891,\"updatedAt\":1766493936,\"audienceRatingImage\":\"themoviedb://image.rating\",\"Image\":[{\"alt\":\"The Owl House\",\"type\":\"coverPoster\",\"url\":\"/library/metadata/26144/thumb/1766493936\"},{\"alt\":\"The Owl House\",\"type\":\"background\",\"url\":\"/library/metadata/26144/art/1766493936\"},{\"alt\":\"The Owl House\",\"type\":\"clearLogo\",\"url\":\"/library/metadata/26144/clearLogo/1766493936\"}],\"UltraBlurColors\":{\"topLeft\":\"291f58\",\"topRight\":\"423476\",\"bottomRight\":\"91423b\",\"bottomLeft\":\"7b3141\"},\"Genre\":[{\"tag\":\"Animation\"},{\"tag\":\"Comedy\"}],\"Country\":[{\"tag\":\"United States of America\"}],\"Role\":[{\"tag\":\"Tati Gabrielle\"},{\"tag\":\"Mae Whitman\"},{\"tag\":\"Issac Ryan Brown\"}]},{\"ratingKey\":\"28458\",\"key\":\"/library/metadata/28458/children\",\"guid\":\"plex://show/62ab5390458587620e2ba57e\",\"slug\":\"primos\",\"studio\":\"Disney Television Animation\",\"type\":\"show\",\"title\":\"Primos\",\"librarySectionTitle\":\"TV Shows\",\"librarySectionID\":5,\"librarySectionKey\":\"/library/sections/5\",\"contentRating\":\"TV-Y7\",\"contentRatingAge\":7,\"summary\":\"Tater, a quirky girl with ambitious dreams for her future and only one summer to sort them out, finds her plans disrupted when her mom unexpectedly invites all 12 of her cousins to visit.\",\"index\":1,\"audienceRating\":7.0,\"year\":2024,\"thumb\":\"/library/metadata/28458/thumb/1767834241\",\"art\":\"/library/metadata/28458/art/1767834241\",\"duration\":1320000,\"originallyAvailableAt\":\"2024-06-14\",\"leafCount\":1,\"viewedLeafCount\":0,\"childCount\":1,\"addedAt\":1767834177,\"updatedAt\":1767834241,\"audienceRatingImage\":\"themoviedb://image.rating\",\"Image\":[{\"alt\":\"Primos\",\"type\":\"coverPoster\",\"url\":\"/library/metadata/28458/thumb/1767834241\"},{\"alt\":\"Primos\",\"type\":\"background\",\"url\":\"/library/metadata/28458/art/1767834241\"},{\"alt\":\"Primos\",\"type\":\"clearLogo\",\"url\":\"/library/metadata/28458/clearLogo/1767834241\"}],\"UltraBlurColors\":{\"topLeft\":\"551208\",\"topRight\":\"823315\",\"bottomRight\":\"761c11\",\"bottomLeft\":\"773330\"},\"Genre\":[{\"tag\":\"Animation\"},{\"tag\":\"Comedy\"}],\"Country\":[{\"tag\":\"United States of America\"}],\"Role\":[{\"tag\":\"Myrna Velasco\"},{\"tag\":\"Elizabeth Grullón\