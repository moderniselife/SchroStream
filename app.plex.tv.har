            "text": "{\"MediaContainer\":{\"size\":31,\"totalSize\":31,\"offset\":0,\"Metadata\":[{\"ratingKey\":\"1265\",\"key\":\"/library/metadata/1265\",\"guid\":\"plex://movie/5e163310fef2d4003e895680\",\"slug\":\"arthur-the-king-2024\",\"studio\":\"Entertainment One\",\"type\":\"movie\",\"title\":\"Arthur the King\",\"librarySectionTitle\":\"Movies\",\"librarySectionID\":1,\"librarySectionKey\":\"/library/sections/1\",\"contentRating\":\"PG-13\",\"contentRatingAge\":13,\"summary\":\"Over the course of ten days and 435 miles, an unbreakable bond is forged between pro adventure racer Michael Light and a scrappy street dog companion dubbed Arthur. As the team is pushed to their outer limits of endurance in the race, Arthur redefines what victory, loyalty and friendship truly mean.\",\"rating\":7.0,\"audienceRating\":9.7,\"year\":2024,\"tagline\":\"An unexpected encounter. An unlikely bond. An unforgettable adventure.\",\"thumb\":\"/library/metadata/1265/thumb/1766022135\",\"art\":\"/library/metadata/1265/art/1766022135\",\"duration\":6422416,\"originallyAvailableAt\":\"2024-02-22\",\"addedAt\":1762648071,\"updatedAt\":1766022135,\"audienceRatingImage\":\"rottentomatoes://image.rating.upright\",\"primaryExtraKey\":\"/library/metadata/1268\",\"ratingImage\":\"rottentomatoes://image.rating.ripe\",\"Media\":[{\"id\":60956,\"duration\":6422416,\"bitrate\":21825,\"width\":3832,\"height\":1592,\"aspectRatio\":2.35,\"audioChannels\":6,\"audioCodec\":\"ac3\",\"videoCodec\":\"hevc\",\"videoResolution\":\"4k\",\"container\":\"mkv\",\"videoFrameRate\":\"24p\",\"videoProfile\":\"main 10\",\"hasVoiceActivity\":false,\"Part\":[{\"id\":60956,\"key\":\"/library/parts/60956/1714598361/file.mkv\",\"duration\":6422416,\"file\":\"/all/pd_zurg/mnt/pd_zurg/movies/Arthur the King (2024) WEB-DL 2160p. SDR/Arthur the King (2024) WEB-DL 2160p. SDR.mkv\",\"size\":17521308255,\"container\":\"mkv\",\"failureBIFResultCode\":\"3\",\"failureBIFRetryCount\":\"2\",\"videoProfile\":\"main 10\"}]},{