          "content": {
            "size": 24676,
            "mimeType": "application/json",
            "compression": 18358,
            "text": "{\"MediaContainer\":{\"size\":15,\"totalSize\":15,\"offset\":0,\"Metadata\":[{\"ratingKey\":\"6237\",\"key\":\"/library/metadata/6237/children\",\"guid\":\"plex://show/5d9c08723c3f87001f3507e4\",\"slug\":\"the-flintstones\",\"studio\":\"Hanna-Barbera Cartoons\",\"type\":\"show\",\"title\":\"The Flintstones\",\"titleSort\":\"Flintstones\",\"librarySectionTitle\":\"TV Shows\",\"librarySectionID\":5,\"librarySectionKey\":\"/library/sections/5\",\"contentRating\":\"TV-Y\",\"contentRatingAge\":5,\"summary\":\"This popular animated television cartoon featured two Stone Age families, the Flintstones and their neighbors, the Rubbles. Much of the humor was based on its comic portrayals of modern conveniences, reinterpreted using Stone Age 'technology.' Most notably were their cars, complete with absence of floorboards to allow them to be 'foot-powered.'\",\"index\":1,\"audienceRating\":7.4,\"year\":1960,\"tagline\":\"Something old - Something new! But nothing borrowed and nothing blue! A brand new idea - an adult cartoon series! THE FLINTSTONES!...a couple just like the folks you know - except they live in the Stone Age!\",\"thumb\":\"/library/metadata/6237/thumb/1767893634\",\"art\":\"/library/metadata/6237/art/1767893634\",\"theme\":\"/library/metadata/6237/theme/1767893634\",\"duration\":1500000,\"originallyAvailableAt\":\"1960-05-01\",\"leafCount\":202,\"viewedLeafCount\":0,\"childCount\":7,\"seasonCount\":6,\"addedAt\":1762686114,\"updatedAt\":1767893634,\"audienceRatingImage\":\"themoviedb://image.rating\",\"primaryExtraKey\":\"/library/metadata/6284\",\"Image\":[{\"alt\":\"The Flintstones\",\"type\":\"coverPoster\",\"url\":\"/library/metadata/6237/thumb/1767893634\"},{\"alt\":\"The Flintstones\",\"type\":\"background\",\"url\":\"/library/metadata/6237/art/1767893634\"},{\"alt\":\"The Flintstones\",\"type\":\"clearLogo\",\"url\":\"/library/metadata/6237/clearLogo/1767893634\"}],\"UltraBlurColors\":{\"topLeft\":\"02381e\",\"topRight\":\"336b45\",\"bottomRight\":\"256d4a\",\"bottomLeft\":\"9c391d\"},\"Genre\":[{\"tag\":\"Family\"},{\"tag\":\"Animation\"}],\"Country\":[{\"tag\":\"United States of America\"}],\"Role\":[{\"tag\":\"Alan Reed\"},{\"tag\":\"Mel Blanc\"},{\"tag\":\"Jean Vander Pyl\"}]},{\"ratingKey\":\"13165\",\"key\":\"/library/metadata/13165/children\",\"guid\":\"plex://show/5d9c0875e98e47001eb10c71\",\"slug\":\"the-smurfs\",\"studio\":\"SEPP International\",\"type\":\"show\",\"title\":\"The Smurfs\",\"titleSort\":\"Smurfs\",\"librarySectionTitle\":\"TV Shows\",\"librarySectionID\":5,\"librarySectionKey\":\"/library/sections/5\",\"originalTitle\":\"Smurfs\",\"contentRating\":\"TV-G\",\"contentRatingAge\":4,\"summary\":\"The Smurfs are tiny blue creatures that live in mushroom houses in a peaceful forest. They repeatedly try to outwit Gargamel, an evil sorcerer, his apprentice, Scruple, and his mangy cat, Azrael.\",\"index\":1,\"audienceRating\":7.0,\"year\":1981,\"thumb\":\"/library/metadata/13165/thumb/1767893638\",\"art\":\"/library/metadata/13165/art/1767893638\",\"theme\":\"/library/metadata/13165/theme/1767893638\",\"duration\":660000,\"originallyAvailableAt\":\"1981-09-12\",\"leafCount\":416,\"viewedLeafCount\":0,\"childCount\":9,\"addedAt\":1762819613,\"updatedAt\":1767893638,\"audienceRatingImage\":\"themoviedb://image.rating\",\"Image\":[{\"alt\":\"The Smurfs\",\"type\":\"coverPoster\",\"url\":\"/library/metadata/13165/thumb/1767893638\"},{\"alt\":\"The Smurfs\",\"type\":\"background\",\"url\":\"/library/metadata/13165/art/1767893638\"},{\"alt\":\"The Smurfs\",\"type\":\"clearLogo\",\"url\":\"/library/metadata/13165/clearLogo/1767893638\"}],\"UltraBlurColors\":{\"topLeft\":\"11333a\",\"topRight\":\"3c6b37\",\"bottomRight\":\"0c557c\",\"bottomLeft\":\"264c21\"},\"Genre\":[{\"tag\":\"Animation\"},{\"tag\":\"Family\"}],\"Country\":[{\"tag\":\"United States of America\"}],\"Role\":[{\"tag\":\"Don Messick\"},{\"tag\":\"Lucille Bliss\"},{\"tag\":\"Frank Welker\"}]},{\"ratingKey\":\"17848\",\"key\":\"/library/metadata/17848/children\",\"guid\":\"plex://show/5d9c086fe98e47001eb0ff4c\",\"slug\":\"the-fairly-oddparents\",\"studio\":\"Billionfold\",\"type\":\"show\",\"title\":\"The Fairly OddParents\",\"titleSort\":\"Fairly OddParents\",\"librarySectionTitle\":\"TV Shows\",\"librarySectionID\":5,\"librarySectionKey\":\"/library/sections/5\",\"contentRating\":\"TV-Y7\",\"contentRatingAge\":6,\"summary\":\"Timmy Turner, a 10-year-old boy, has had it with his cruel babysitter, neglectful parents and sadist teacher. Due to his misery, he summons his fairy godparents who have the power to grant him wishes. Some of the wishes are really helpful, others don't work out so well. Timmy's fairy godparents Cosmo and Wanda have ideas of their own and always lead Timmy on many magical adventures.\",\"index\":1,\"audienceRating\":7.6,\"lastViewedAt\":1766044109,\"year\":2001,\"thumb\":\"/library/metadata/17848/thumb/1768838633\",\"art\":\"/library/metadata/17848/art/1768838633\",\"theme\":\"/library/metadata/17848/theme/1768838633\",\"duration\":720000,\"originallyAvailableAt\":\"2001-03-30\",\"leafCount\":32,\"viewedLeafCount\":28,\"childCount\":2,\"addedAt\":1765970374,\"updatedAt\":1768838633,\"audienceRatingImage\":\"themoviedb://image.rating\",\"Image\":[{\"alt\":\"The Fairly OddParents\",\"type\":\"coverPoster\",\"url\":\"/library/metadata/17848/thumb/1768838633\"},{\"alt\":\"The Fairly OddParents\",\"type\":\"background\",\"url\":\"/library/metadata/17848/art/1768838633\"},{\"alt\":\"The Fairly OddParents\",\"type\":\"clearLogo\",\"url\":\"/library/metadata/17848/clearLogo/1768838633\"}],\"UltraBlurColors\":{\"topLeft\":\"361e57\",\"topRight\":\"5d3176\",\"bottomRight\":\"6a377d\",\"bottomLeft\":\"7c36a5\"},\"Genre\":[{\"tag\":\"Animation\"},{\"tag\":\"Comedy\"}],\"Country\":[{\"tag\":\"Canada\"},{\"tag\":\"United States of America\"}],\"Role\":[{\"tag\":\"Gary LeRoi Gray\"},{\"tag\":\"Tara Strong\"},{\"tag\":\"Susanne Blakeslee\"}]},{\"ratingKey\":\"19196\",\"key\":\"/library/metadata/19196/children\",\"guid\":\"plex://show/60e18814bc76bc002c1173d1\",\"slug\":\"the-fairly-oddparents-fairly-odder\",\"studio\":\"Nickelodeon Productions\",\"type\":\"show\",\"title\":\"The Fairly OddParents: Fairly Odder\",\"titleSort\":\"Fairly OddParents: Fairly Odder\",\"librarySectionTitle\":\"TV Shows\",\"librarySectionID\":5,\"librarySectionKey\":\"/library/sections/5\",\"originalTitle\":\"The Fairly Oddparents: Fairly Odder\",\"contentRating\":\"TV-G\",\"contentRatingAge\":7,\"summary\":\"When Ty Turner uproots his life to reunite with his high school sweetheart, Rachel Raskin, in the colorful town of Dimmsdale, his cautious 13-year-old daughter Vivian is thrust into a new world, and a new school alongside new step-brother and town star, Roy, a jock with a heart of gold. Lucky for Viv she’s inherited Wanda and Cosmo, two Fairy Godparents she’ll share with Roy, to help them both find their way.\",\"index\":1,\"audienceRating\":6.3,\"year\":2022,\"thumb\":\"/library/metadata/19196/thumb/1768838636\",\"art\":\"/library/metadata/19196/art/1768838636\",\"duration\":19500000,\"originallyAvailableAt\":\"2022-03-31\",\"leafCount\":2,\"viewedLeafCount\":0,\"childCount\":1,\"addedAt\":1766036406,\"updatedAt\":1768838636,\"audienceRatingImage\":\"themoviedb://image.rating\",\"primaryExtraKey\":\"/library/metadata/19206\",\"Image\":[{\"alt\":\"The Fairly OddParents: Fairly Odder\",\"type\":\"coverPoster\",\"url\":\"/library/metadata/19196/thumb/1768838636\"},{\"alt\":\"The Fairly OddParents: Fairly Odder\",\"type\":\"background\",\"url\":\"/library/metadata/19196/art/1768838636\"},{\"alt\":\"The Fairly OddParents: Fairly Odder\",\"type\":\"clearLogo\",\"url\":\"/library/metadata/19196/clearLogo/1768838636\"}],\"UltraBlurColors\":{\"topLeft\":\"4c1d19\",\"topRight\":\"5f2335\",\"bottomRight\":\"193d68\",\"bottomLeft\":\"9f3423\"},\"Genre\":[{\"tag\":\"Comedy\"},{\"tag\":\"Adventure\"}],\"Country\":[{\"tag\":\"United States of America\"}],\"Role\":[{\"tag\":\"Audrey Grace Marshall\"},{\"tag\":\"Tyler Wladis\"},{\"tag\":\"Laura Bell Bundy\"}]},{\"ratingKey\":\"19338\",\"key\":\"/library/metadata/19338/children\",\"guid\":\"plex://show/65d9df70d0a49cf8527b4904\",\"slug\":\"the-fairly-oddparents-a-new-wish\",\"studio\":\"Nickelodeon Animation Studio\",\"type\":\"show\",\"title\":\"The Fairly OddParents: A New Wish\",\"titleSort\":\"Fairly OddParents: A New Wish\",\"librarySectionTitle\":\"TV Shows\",\"librarySectionID\":5,\"librarySectionKey\":\"/library/sections/5\",\"contentRating\":\"TV-Y7\",\"contentRatingAge\":6,\"summary\":\"Hazel, a ten-year-old girl who has just moved to the big city of Dimmadelphia for her father's new job, explores the city on her own after her brother Antony leaves for college.\",\"index\":1,\"audienceRating\":8.2,\"year\":2024,\"thumb\":\"/library/metadata/19338/thumb/1768838637\",\"art\":\"/library/metadata/19338/art/1768838637\",\"duration\":660000,\"originallyAvailableAt\":\"2024-05-17\",\"leafCount\":36,\"viewedLeafCount\":0,\"childCount\":1,\"addedAt\":1766036873,\"updatedAt\":1768838637,\"audienceRatingImage\":\"themoviedb://image.rating\",\"primaryExtraKey\":\"/library/metadata/19392\",\"Image\":[{\"alt\":\"The Fairly OddParents: A New Wish\",\"type\":\"coverPoster\",\"url\":\"/library/metadata/19338/thumb/1768838637\"},{\"alt\":\"The Fairly OddParents: A New Wish\",\"type\":\"background\",\"url\":\"/library/metadata/19338/art/1768838637\"},{\"alt\":\"The Fairly OddParents: A New Wish\",\"type\":\"clearLogo\",\"url\":\"/library/metadata/19338/clearLogo/1768838637\"}],\"UltraBlurColors\":{\"topLeft\":\"082470\",\"topRight\":\"1b4baf\",\"bottomRight\":\"0960a2\",\"bottomLeft\":\"055fa8\"},\"Genre\":[{\"tag\":\"Animation\"},{\"tag\":\"Adventure\"}],\"Country\":[{\"tag\":\"United States of America\"}],\"Role\":[{\"tag\":\"Ashleigh Crystal Hairston\"},{\"tag\":\"Susanne Blakeslee\"},{\"tag\":\"Daran Norris\"}]},{\"ratingKey\":\"19376\",\"key\":\"/library/metadata/19376/children\",\"guid\":\