ack Kukoda\"}],\"Role\":[{\"tag\":\"America Ferrera\"},{\"tag\":\"Ben Feldman\"},{\"tag\":\"Lauren Ash\"}]},{\"ratingKey\":\"10792\",\"key\":\"/library/metadata/10792\",\"parentRatingKey\":\"10786\",\"grandparentRatingKey\":\"8100\",\"guid\":\"plex://episode/5d9c1213e264b7001fca68fd\",\"parentGuid\":\"plex://season/602e671233eb76002d618656\",\"grandparentGuid\":\"plex://show/5d9c08682192ba001f30f2ce\",\"grandparentSlug\":\"superstore\",\"type\":\"episode\",\"title\":\"Secret Shopper\",\"grandparentKey\":\"/library/metadata/8100\",\"parentKey\":\"/library/metadata/10786\",\"grandparentTitle\":\"Superstore\",\"parentTitle\":\"Season 1\",\"contentRating\":\"TV-14\",\"summary\":\"When Glenn publicly congratulates Jonah for his superb test results, Amy becomes slightly annoyed and competitive, resulting in a chaotic battle of street smarts vs. book smarts. Meanwhile, the rest of the Cloud 9 team are on the lookout for a secret shopper, determined to be on their best behavior for him.\",\"index\":6,\"parentIndex\":1,\"audienceRating\":7.1,\"viewCount\":2,\"lastViewedAt\":1768456588,\"year\":2016,\"thumb\":\"/library/metadata/10792/thumb/1762786245\",\"art\":\"/library/metadata/10786/art/1762788064\",\"parentThumb\":\"/library/metadata/10786/thumb/1762788064\",\"grandparentThumb\":\"/library/metadata/8100/thumb/1767893636\",\"grandparentArt\":\"/library/metadata/8100/art/1767893636\",\"grandparentTheme\":\"/library/metadata/8100/theme/1767893636\",\"duration\":1284033,\"originallyAvailableAt\":\"2016-01-18\",\"addedAt\":1762786245,\"audienceRatingImage\":\"themoviedb://image.rating\",\"Media\":[{\"id\":18849,\"duration\":1284033,\"bitrate\":4143,\"width\":1920,\"height\":1080,\"aspectRatio\":1.78,\"audioChannels\":6,\"audioCodec\":\"eac3\",\"videoCodec\":\"hevc\",\"videoResolution\":\"1080\",\"container\":\"mkv\",\"videoFrameRate\":\"24p\",\"videoProfile\":\"main 10\",\"hasVoiceActivity\":false,\"Part\":[{\"id\":18849,\"key\":\"/library/parts/18849/1767299608/file.mkv\",\"