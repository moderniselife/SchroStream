lter\":\"actor=18244\",\"tag\":\"Turan Bayat\",\"tagKey\":\"5ef15439b110780041755bd3\",\"role\":\"Mar Man\"},{\"id\":18245,\"filter\":\"actor=18245\",\"tag\":\"Emine Şule Bagriyan\",\"tagKey\":\"66bf40060e0fc2392b42aa05\",\"role\":\"Mar Woman\"}]},{\"ratingKey\":\"28501\",\"key\":\"/library/metadata/28501/children\",\"parentRatingKey\":\"28500\",\"guid\":\"plex://season/6606b5ae07f78b8316992776\",\"parentGuid\":\"plex://show/5e269a91752e36003dd925b5\",\"parentSlug\":\"mayor-of-kingstown\",\"parentStudio\":\"101 Studios\",\"type\":\"season\",\"title\":\"Season 3\",\"parentKey\":\"/library/metadata/28500\",\"librarySectionTitle\":\"TV Shows\",\"librarySectionID\":5,\"librarySectionKey\":\"/library/sections/5\",\"parentTitle\":\"Mayor of Kingstown\",\"summary\":\"In season three, a series of explosions rock Kingstown and its citizens, as a new face of the Russian mob sets up shop in the city, and a drug war rages inside and outside prison walls. The pressure is on Mike McLusky to end the war but things get complicated when a familiar face from his incarcerated past threatens to undermine the Mayor's attempts to keep the peace among all factions.\",\"index\":3,\"parentIndex\":1,\"parentYear\":2021,\"thumb\":\"/library/metadata/28501/thumb/1767835042\",\"art\":\"/library/metadata/28501/art/1767835042\",\"parentThumb\":\"/library/metadata/28500/thumb/1767835042\",\"parentTheme\":\"/library/metadata/28500/theme/1767835042\",\"leafCount\":10,\"viewedLeafCount\":0,\"addedAt\":1767834996,\"updatedAt\":1767835042,\"Image\":[{\"alt\":\"Season 3\",\"type\":\"coverPoster\",\"url\":\"/library/metadata/28501/thumb/1767835042\"},{\"alt\":\"Season 3\",\"type\":\"background\",\"url\":\"/library/metadata/28501/art/1767835042\"},{\"alt\":\"Season 3\",\"type\":\"clearLogo\",\"url\":\"/library/metadata/28500/clearLogo/1767835042\"}],\"UltraBlurColors\":{\"topLeft\":\"060619\",\"topRight\":\"242828\",\"bottomRight\":\"a0331e\",\"bottomLeft\":\"11333c\"},\"Guid\":[{\"id\":\"tmdb://385973\"}