art\":\"/library/metadata/28794/art/1768510488\",\"parentThumb\":\"/library/metadata/28793/thumb/1768838645\",\"leafCount\":2,\"viewedLeafCount\":0,\"addedAt\":1768510483,\"updatedAt\":1768510488,\"Image\":[{\"alt\":\"Season 1\",\"type\":\"coverPoster\",\"url\":\"/library/metadata/28794/thumb/1768510488\"},{\"alt\":\"Season 1\",\"type\":\"background\",\"url\":\"/library/metadata/28794/art/1768510488\"},{\"alt\":\"Season 1\",\"type\":\"clearLogo\",\"url\":\"/library/metadata/28793/clearLogo/1768838645\"}],\"UltraBlurColors\":{\"topLeft\":\"210c28\",\"topRight\":\"3d0f15\",\"bottomRight\":\"2d0c17\",\"bottomLeft\":\"672749\"},\"Guid\":[{\"id\":\"tmdb://334969\"},{\"id\":\"tvdb://2055923\"}]},{\"ratingKey\":\"28781\",\"key\":\"/library/metadata/28781/children\",\"guid\":\"plex://show/6262c52fc0e1db31c74755bd\",\"slug\":\"hijack\",\"studio\":\"Green Door Pictures\",\"type\":\"show\",\"title\":\"Hijack\",\"librarySectionTitle\":\"TV Shows\",\"librarySectionID\":5,\"librarySectionKey\":\"/library/sections/5\",\"contentRating\":\"TV-MA\",\"contentRatingAge\":15,\"summary\":\"A tense thriller (told in real time) that follows the journey of a hijacked plane as it makes its way to London over a seven-hour flight, while authorities on the ground scramble for answers. Sam Nelson (Elba) is an accomplished negotiator in the business world, who needs to step up and use all his guile to try and save the lives of the passengers -- but, his high-risk strategy could be his undoing.\",\"index\":1,\"audienceRating\":7.7,\"year\":2023,\"tagline\":\"Let them think they're in control.\",\"thumb\":\"/library/metadata/28781/thumb/1768838645\",\"art\":\"/library/metadata/28781/art/1768838645\",\"theme\":\"/library/metadata/28781/theme/1768838645\",\"duration\":2820000,\"originallyAvailableAt\":\"2023-06-28\",\"leafCount\":8,\"viewedLeafCount\":0,\"childCount\":2,\"addedAt\":1768506608,\"updatedAt\":1768838645,\"audienceRatingImage\":\"themoviedb://image.rating\",\"primaryExtraKey\":\"/library