            "text": "{\"MediaContainer\":{\"size\":75,\"totalSize\":475,\"offset\":0,\"allowSync\":true,\"identifier\":\"com.plexapp.plugins.library\",\"Metadata\":[{\"ratingKey\":\"29036\",\"key\":\"/library/metadata/29036\",\"guid\":\"plex://movie/5d7768352e80df001ebde5e5\",\"slug\":\"friday\",\"studio\":\"New Line Cinema\",\"type\":\"movie\",\"title\":\"Friday\",\"librarySectionTitle\":\"Movies\",\"librarySectionID\":1,\"librarySectionKey\":\"/library/sections/1\",\"contentRating\":\"R\",\"contentRatingAge\":16,\"summary\":\"A lot can happen between Thursday and Saturday - Before the sun sets, Craig must get his friend out of trouble, find a new job so his parents don't evict him, escape his girlfriend long enough to capture a new woman's heart and survive a climatic confrontation with the neighborhood menace.\",\"rating\":7.7,\"audienceRating\":9.1,\"year\":1995,\"tagline\":\"A lot can go down between Thursday and Saturday...\",\"thumb\":\"/library/metadata/29036/thumb/1768794889\",\"art\":\"/library/metadata/29036/art/1768794889\",\"duration\":5826368,\"originallyAvailableAt\":\"1995-04-26\",\"addedAt\":1768794882,\"updatedAt\":1768794889,\"audienceRatingImage\":\"rottentomatoes://image.rating.upright\",\"chapterSource\":\"media\",\"primaryExtraKey\":\"/library/metadata/29037\",\"ratingImage\":\"rottentomatoes://image.rating.ripe\",\"Media\":[{\"id\":69300,\"duration\":5826368,\"bitrate\":24581,\"width\":1920,\"height\":1080,\"aspectRatio\":1.78,\"audioChannels\":8,\"audioCodec\":\"truehd\",\"videoCodec\":\"vc1\",\"videoResolution\":\"1080\",\"container\":\"mkv\",\"videoFrameRate\":\"24p\",\"videoProfile\":\"advanced\",\"hasVoiceActivity\":false,\"Part\":[{\"id\":69300,\"key\":\"/library/parts/69300/1761811319/file.mkv\",\"duration\":5826368,\"file\":\"/all/pd_zurg/mnt/pd_zurg/movies/Friday.1995.DC.1080p.BluRay.Remux.TrueHD.7.1/Friday.1995.DC.1080p.BluRay.Remux.TrueHD.7.1.mkv\",\"size\":17902073919,\"container\":\"mkv\",\"hasThumbnail\":\"1\",\"indexes\":\"sd\",\"videoProfile\":\"advanced\"}]}],\"Image\":[{\"alt\":\"Friday\",\"type\":\"coverPoster\",\"url\":\"/library/metadata/29036/thumb/1768794889\"},{\"alt\":\"Friday\",\"type\":\"background\",\"url\":\"/library/metadata/29036/art/1768794889\"},{\"alt\":\"Friday\",\"type\":\"clearLogo\",\"url\":\"/library/metadata/29036/clearLogo/1768794889\"}],\"UltraBlurColors\":{\"topLeft\":\"0f2f50\",\"topRight\":\"096398\",\"bottomRight\":\"30578d\",\"bottomLeft\":\"923c52\"},\"Genre\":[{\"tag\":\"Comedy\"},{\"tag\":\"Drama\"}],\"Country\":[{\"tag\":\"United States of America\"}],\"Director\":[{\"tag\":\"F. Gary Gray\"}],\"Writer\":[{\"tag\":\"DJ Pooh\"},{\"tag\":\"Ice Cube\"}],\"Role\":[{\"tag\":\"Ice Cube\"},{\"tag\":\"Chris Tucker\"},{\"tag\":\"Nia Long\"}]},{\"ratingKey\":\"29032\",\"key\":\"/library/metadata/29032\",\"guid\":\"plex://movie/5d77682cf54112001f5bc78d\",\"slug\":\"his-girl-friday\",\"studio\":\"Columbia Pictures\",\"type\":\"movie\",\"title\":\"His Girl Friday\",\"librarySectionTitle\":\"Movies\",\"librarySectionID\":1,\"librarySectionKey\":\"/library/sections/1\",\"contentRating\":\"Passed\",\"contentRatingAge\":12,\"summary\":\"Walter Burns is an irresistibly conniving newspaper publisher desperate to woo back his paper’s star reporter, who also happens to be his estranged wife. She’s threatening to quit and settle down with a new beau, but, as Walter knows, she has a weakness: she can’t resist a juicy scoop.\",\"rating\":9.9,\"audienceRating\":9.0,\"year\":1940,\"tagline\":\"They're at each other's throats when they're not in each other's arms!\",\"thumb\":\"/library/metadata/29032/thumb/1768790991\",\"art\":\"/library/metadata/29032/art/1768790991\",\"duration\":5517515,\"originallyAvailableAt\":\"1940-01-18\",\"addedAt\":1768790984,\"updatedAt\":1768790991,\"audienceRatingImage\":\"rottentomatoes://image.rating.upright\",\"chapterSource\":\"media\",\"primaryExtraKey\":\"/library/metadata/29033\",\"ratingImage\":\"rottentomatoes://image.rating.ripe\",\"Media\"