            "text": "{\"MediaContainer\":{\"size\":36,\"totalSize\":13373,\"offset\":0,\"allowSync\":true,\"art\":\"/:/resources/show-fanart.jpg\",\"identifier\":\"com.plexapp.plugins.library\",\"librarySectionID\":5,\"librarySectionTitle\":\"TV Shows\",\"librarySectionUUID\":\"a51a3802-023e-4f11-9dcb-a06e8588e236\",\"mediaTagPrefix\":\"/system/bundle/media/flags/\",\"mediaTagVersion\":1758205129,\"nocache\":true,\"thumb\":\"/:/resources/show.png\",\"title1\":\"TV Shows\",\"title2\":\"All Shows\",\"viewGroup\":\"show\",\"viewMode\":65592,\"Metadata\":[{\"ratingKey\":\"29022\",\"key\":\"/library/metadata/29022\",\"parentRatingKey\":\"28800\",\"grandparentRatingKey\":\"28799\",\"guid\":\"plex://episode/684b1fb226018cb84791cdcc\",\"parentGuid\":\"plex://season/6400efa967b6c26c234bdd8b\",\"grandparentGuid\":\"plex://show/5d9c08353c3f87001f34a4c3\",\"grandparentSlug\":\"phineas-and-ferb\",\"type\":\"episode\",\"title\":\"VENDPOCALYPSE: THE MUSICAL\",\"grandparentKey\":\"/library/metadata/28799\",\"parentKey\":\"/library/metadata/28800\",\"grandparentTitle\":\"Phineas and Ferb\",\"parentTitle\":\"Season 5\",\"contentRating\":\"TV-G\",\"summary\":\"Doof's greatest fear comes true when vending machines take over and his robot Norm must choose between humans and machines. Candace steps up to help the kids while Perry teams up with Doofenshmirtz to save the citizens of Danville and stop the vending machine apocalypse.\",\"index\":38,\"parentIndex\":5,\"year\":2026,\"thumb\":\"/library/metadata/29022/thumb/1768838543\",\"art\":\"/library/metadata/28800/art/1768631394\",\"parentThumb\":\"/library/metadata/28800/thumb/1768631394\",\"grandparentThumb\":\"/library/metadata/28799/thumb/1768631390\",\"grandparentArt\":\"/library/metadata/28799/art/1768631390\",\"grandparentTheme\":\"/library/metadata/28799/theme/1768631390\",\"duration\":1380608,\"originallyAvailableAt\":\"2026-01-16\",\"addedAt\":1768635731,\"updatedAt\":1768838543,\"Media\":[{\"id\":69282,\"duration\":1380608,\"bitrate\":1512,\"width\":1280,\"height\":720,\"aspectRatio\":1.78,\"audioChannels\":2,\"audioCodec\":\"aac\",\"videoCodec\":\"h264\",\"videoResolution\":\"720\",\"container\":\"mp4\",\"videoFrameRate\":\"24p\",\"optimizedForStreaming\":0,\"audioProfile\":\"he-aac\",\"has64bitOffsets\":false,\"videoProfile\":\"high\",\"hasVoiceActivity\":false,\"Part\":[{\"id\":69282,\"key\":\"/library/parts/69282/1768571921/file.mp4\",\"duration\":1380608,\"file\":\"/pd_zurg/shows/Phineas And Ferb S05E38 HDTV x264-NGP[EZTVx.to]/Phineas And Ferb S05E38 HDTV x264-NGP[EZTVx.to].mp4\",\"size\":260941567,\"audioProfile\":\"he-aac\",\"container\":\"mp4\",\"has64bitOffsets\":false,\"indexes\":\"sd\",\"optimizedForStreaming\":false,\"videoProfile\":\"high\"}]}],\"Image\":[{\"alt\":\"VENDPOCALYPSE: THE MUSICAL\",\"type\":\"coverPoster\",\"url\":\"/library/metadata/28799/thumb/1768631390\"},{\"alt\":\"VENDPOCALYPSE: THE MUSICAL\",\"type\":\"snapshot\",\"url\":\"/library/metadata/29022/thumb/1768838543\"},{\"alt\":\"VENDPOCALYPSE: THE MUSICAL\",\"type\":\"background\",\"url\":\"/library/metadata/28800/art/1768631394\"},{\"alt\":\"VENDPOCALYPSE: THE MUSICAL\",\"type\":\"clearLogo\",\"url\":\"/library/metadata/28799/clearLogo/1768631390\"}],\"UltraBlurColors\":{\"topLeft\":\"093725\",\"topRight\":\"772e46\",\"bottomRight\":\"2c3ba1\",\"bottomLeft\":\"923f44\"},\"Writer\":[{\"tag\":\"Joshua Pruett\"}],\"Role\":[{\"tag\":\"Vincent Martella\"},{\"tag\":\"David Errigo Jr.\"},{\"tag\":\"Ashley French\"}]},{\"ratingKey\":\"28796\",\"key\":\"/library/metadata/28796\",\"parentRatingKey\":\"28794\",\"grandparentRatingKey\":\"28793\",\"guid\":\"plex://episode/6426d5448debdad084451240\",\"parentGuid\":\"plex://season/642716d7d7cfd84e61279337\",\"grandparentGuid\":\"plex://show/6426d5438debdad08445123d\",\"grandparentSlug\":\"star-trek-starfleet-academy\",\"type\":\"episode\",\"title\":\"Kids These Days\",\"grandparentKey\":\"/library/metadata/28793\",\"parentKey\":\"/library/metadata/28794\",\"grandparentTit